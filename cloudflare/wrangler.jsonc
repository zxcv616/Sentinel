{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel-airspace",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {"bindings": [{"name": "AIRSPACE", "class_name": "Airspace"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Airspace"]}],
  "vars": {
    "POLL_SECONDS": "240",
    "RAW_RECORD_LIMIT": "64",
    "MAX_CLIENTS": "20"
  }
}
